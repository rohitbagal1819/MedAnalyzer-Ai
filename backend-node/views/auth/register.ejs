<%- include('../partials/header') %>

<div class="auth-container">
  <div class="auth-card slide-up" style="max-width: 520px;">
    <div class="text-center mb-3">
      <div style="width:48px;height:48px;border-radius:12px;background:var(--gradient-primary);display:inline-flex;align-items:center;justify-content:center;margin-bottom:1rem;">
        <i class="bi bi-person-plus" style="color:white;font-size:1.3rem;"></i>
      </div>
    </div>
    <h1 class="auth-title">Create Account</h1>
    <p class="auth-subtitle">Join MedAnalyzer AI to start analyzing your health data</p>

    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
      <% errors.forEach(err => { %>
        <div class="alert-custom alert-critical" style="margin-bottom: 1rem;">
          <i class="bi bi-exclamation-circle" style="color:var(--danger-500);"></i>
          <span style="font-size:0.85rem;"><%= err.msg %></span>
        </div>
      <% }) %>
    <% } %>

    <form action="/register" method="POST" id="registerForm">
      <!-- Role Selector -->
      <div class="role-selector">
        <button type="button" class="role-option active" data-role="patient" onclick="selectRegRole(this, 'patient')">
          <i class="bi bi-person me-1"></i>Patient
        </button>
        <button type="button" class="role-option" data-role="doctor" onclick="selectRegRole(this, 'doctor')">
          <i class="bi bi-hospital me-1"></i>Doctor
        </button>
      </div>
      <input type="hidden" name="role" id="roleInput" value="patient">

      <!-- Common fields -->
      <div class="form-floating-custom">
        <label for="name">Full Name</label>
        <input type="text" class="form-control" id="name" name="name" 
               placeholder="John Doe" required
               value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>">
      </div>

      <div class="form-floating-custom">
        <label for="email">Email Address</label>
        <input type="email" class="form-control" id="email" name="email" 
               placeholder="you@example.com" required
               value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>">
      </div>

      <div class="form-floating-custom">
        <label for="password">Password (min 6 characters)</label>
        <input type="password" class="form-control" id="password" name="password" 
               placeholder="Create a password" required minlength="6">
      </div>

      <!-- Patient-specific fields -->
      <div class="role-fields active" id="patientFields">
        <div class="row">
          <div class="col-6">
            <div class="form-floating-custom">
              <label for="age">Age</label>
              <input type="number" class="form-control" id="age" name="age" 
                     placeholder="25" min="0" max="150">
            </div>
          </div>
          <div class="col-6">
            <div class="form-floating-custom">
              <label for="gender">Gender</label>
              <select class="form-select-custom" id="gender" name="gender">
                <option value="">Select</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-6">
            <div class="form-floating-custom">
              <label for="bloodGroup">Blood Group</label>
              <select class="form-select-custom" id="bloodGroup" name="bloodGroup">
                <option value="">Select</option>
                <option value="A+">A+</option>
                <option value="A-">A-</option>
                <option value="B+">B+</option>
                <option value="B-">B-</option>
                <option value="AB+">AB+</option>
                <option value="AB-">AB-</option>
                <option value="O+">O+</option>
                <option value="O-">O-</option>
              </select>
            </div>
          </div>
          <div class="col-6">
            <div class="form-floating-custom">
              <label for="healthId">Health ID (ABDM)</label>
              <input type="text" class="form-control" id="healthId" name="healthId" 
                     placeholder="Optional">
            </div>
          </div>
        </div>
      </div>

      <!-- Doctor-specific fields -->
      <div class="role-fields" id="doctorFields">
        <div class="form-floating-custom">
          <label for="specialization">Specialization</label>
          <input type="text" class="form-control" id="specialization" name="specialization" 
                 placeholder="e.g., Cardiology">
        </div>
        <div class="form-floating-custom">
          <label for="licenseNumber">Medical License Number</label>
          <input type="text" class="form-control" id="licenseNumber" name="licenseNumber" 
                 placeholder="e.g., MCI-12345">
        </div>
      </div>

      <button type="submit" class="btn btn-primary-custom w-100 py-2 mb-3">
        <i class="bi bi-person-plus me-2"></i>Create Account
      </button>

      <p class="text-center" style="font-size:0.9rem; color: var(--text-muted);">
        Already have an account? <a href="/login" style="font-weight:600;">Sign in</a>
      </p>
    </form>
  </div>
</div>

<script>
function selectRegRole(btn, role) {
  document.querySelectorAll('.role-option').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('roleInput').value = role;

  document.getElementById('patientFields').classList.remove('active');
  document.getElementById('doctorFields').classList.remove('active');

  if (role === 'patient') {
    document.getElementById('patientFields').classList.add('active');
  } else {
    document.getElementById('doctorFields').classList.add('active');
  }
}
</script>

<script src="/js/theme.js"></script>
</body>
</html>
