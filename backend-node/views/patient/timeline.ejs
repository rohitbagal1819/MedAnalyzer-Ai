<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="page-container">
  <div class="page-header">
    <h1 class="page-title"><i class="bi bi-clock-history me-2" style="color:var(--primary-500);"></i>Health Timeline</h1>
    <p class="page-subtitle">Your complete medical history in chronological order</p>
  </div>

  <% if (reports.length > 0) { %>
    <div class="row">
      <div class="col-lg-8">
        <div class="timeline-container">
          <% reports.forEach((report, index) => { %>
            <div class="timeline-item" <%- `style="animation-delay: ${index * 0.1}s;"` %>>
              <div class="timeline-dot"></div>
              <div class="timeline-date">
                <%= new Date(report.uploadDate).toLocaleDateString('en-IN', { weekday:'short', day:'numeric', month:'long', year:'numeric' }) %>
              </div>
              <div class="timeline-card">
                <div class="d-flex align-items-start justify-content-between mb-2">
                  <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-<%= report.fileType === 'pdf' ? 'file-pdf' : 'file-image' %>" 
                       style="font-size:1.3rem; color:var(--primary-500);"></i>
                    <div>
                      <h4 style="font-weight:700; font-size:1rem; margin:0;"><%= report.reportType %></h4>
                      <span style="font-size:0.8rem; color:var(--text-muted);"><%= report.fileName %></span>
                    </div>
                  </div>
                  <div class="d-flex align-items-center gap-2">
                    <span class="processing-badge processing-<%= report.processingStatus %>">
                      <% if (report.processingStatus === 'processing') { %><span class="spinner-dot"></span><% } %>
                      <%= report.processingStatus %>
                    </span>
                    <form action="/reports/delete/<%= report._id %>" method="POST" class="m-0" onsubmit="return confirm('Are you sure you want to delete this report?');">
                      <button type="submit" class="btn btn-sm" style="color: var(--danger-500); background: transparent; border: none; padding: 0 0.5rem;" title="Delete Report">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </div>

                <% if (report.processingStatus === 'done' && report.extractedData) { %>
                  <!-- Lab Values Summary -->
                  <% if (report.extractedData.labValues && report.extractedData.labValues.length > 0) { %>
                    <div class="mt-3 mb-2">
                      <span style="font-size:0.8rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:1px;">
                        Lab Results
                      </span>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                      <% report.extractedData.labValues.slice(0, 4).forEach(lv => { %>
                        <span class="status-badge status-<%= lv.status %>">
                          <span class="status-dot"></span>
                          <%= lv.testName %>: <%= lv.value %> <%= lv.unit %>
                        </span>
                      <% }) %>
                      <% if (report.extractedData.labValues.length > 4) { %>
                        <span style="font-size:0.8rem; color:var(--text-muted); align-self:center;">
                          +<%= report.extractedData.labValues.length - 4 %> more
                        </span>
                      <% } %>
                    </div>
                  <% } %>

                  <!-- Medications -->
                  <% if (report.extractedData.medications && report.extractedData.medications.length > 0) { %>
                    <div class="mb-2">
                      <span style="font-size:0.8rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:1px;">
                        Medications
                      </span>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                      <% report.extractedData.medications.forEach(med => { %>
                        <span style="background:rgba(139,92,246,0.08); color:var(--accent-600); padding:0.2rem 0.6rem; border-radius:var(--radius-full); font-size:0.8rem; font-weight:500;">
                          <i class="bi bi-capsule me-1"></i><%= med.name %> <% if(med.dosage) { %>(<%= med.dosage %>)<% } %>
                        </span>
                      <% }) %>
                    </div>
                  <% } %>

                  <!-- Doctor & Hospital -->
                  <% if (report.extractedData.doctorName || report.extractedData.hospitalName) { %>
                    <div style="font-size:0.8rem; color:var(--text-muted); border-top:1px solid var(--border-color); padding-top:0.75rem; margin-top:0.5rem;">
                      <% if (report.extractedData.doctorName) { %>
                        <i class="bi bi-person me-1"></i>Dr. <%= report.extractedData.doctorName %>
                      <% } %>
                      <% if (report.extractedData.hospitalName) { %>
                        <span class="ms-3"><i class="bi bi-hospital me-1"></i><%= report.extractedData.hospitalName %></span>
                      <% } %>
                    </div>
                  <% } %>

                  <!-- Health Score -->
                  <div class="d-flex align-items-center justify-content-between mt-3 pt-2" style="border-top:1px solid var(--border-color);">
                    <span style="font-size:0.8rem; color:var(--text-muted);">Report Health Score</span>
                    <div class="mini-score <%= report.healthScore >= 70 ? 'score-good' : report.healthScore >= 40 ? 'score-moderate' : 'score-poor' %>">
                      <%= report.healthScore %>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Sidebar Stats -->
      <div class="col-lg-4">
        <div class="card-custom mb-3">
          <h4 style="font-weight:700; font-size:0.95rem; margin-bottom:1rem;">
            <i class="bi bi-bar-chart me-2" style="color:var(--primary-500);"></i>Timeline Stats
          </h4>
          <div class="d-flex justify-content-between mb-2">
            <span style="font-size:0.85rem; color:var(--text-muted);">Total Reports</span>
            <span style="font-weight:700;"><%= reports.length %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span style="font-size:0.85rem; color:var(--text-muted);">Blood Tests</span>
            <span style="font-weight:700;"><%= reports.filter(r => r.reportType === 'Blood Test').length %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span style="font-size:0.85rem; color:var(--text-muted);">Prescriptions</span>
            <span style="font-weight:700;"><%= reports.filter(r => r.reportType === 'Prescription').length %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span style="font-size:0.85rem; color:var(--text-muted);">Others</span>
            <span style="font-weight:700;"><%= reports.filter(r => !['Blood Test','Prescription'].includes(r.reportType)).length %></span>
          </div>
        </div>

        <div class="card-custom">
          <h4 style="font-weight:700; font-size:0.95rem; margin-bottom:1rem;">
            <i class="bi bi-lightbulb me-2" style="color:var(--warning-500);"></i>Quick Actions
          </h4>
          <a href="/upload" class="btn btn-glass w-100 mb-2" style="justify-content:flex-start; display:flex; align-items:center;">
            <i class="bi bi-cloud-upload me-2"></i>Upload New Report
          </a>
          <a href="/lab-results" class="btn btn-glass w-100 mb-2" style="justify-content:flex-start; display:flex; align-items:center;">
            <i class="bi bi-clipboard2-pulse me-2"></i>View Lab Results
          </a>
          <a href="/summary" class="btn btn-glass w-100" style="justify-content:flex-start; display:flex; align-items:center;">
            <i class="bi bi-file-medical me-2"></i>Doctor Summary
          </a>
        </div>
      </div>
    </div>
  <% } else { %>
    <div class="card-custom">
      <div class="empty-state">
        <div class="empty-state-icon">📋</div>
        <h3>No Reports in Timeline</h3>
        <p>Upload your first medical report to start building your health timeline</p>
        <a href="/upload" class="btn btn-primary-custom mt-3">
          <i class="bi bi-cloud-upload me-2"></i>Upload Report
        </a>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
