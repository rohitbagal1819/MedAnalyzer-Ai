<nav class="navbar navbar-expand-lg navbar-custom fixed-top">
  <div class="container">
    <a class="navbar-brand" href="/">
      <span class="brand-icon"><i class="bi bi-heart-pulse"></i></span>
      MedAnalyzer AI
    </a>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <i class="bi bi-list" style="font-size: 1.5rem; color: var(--text-primary);"></i>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav ms-auto align-items-center gap-1">
        <% if (typeof user !== 'undefined' && user) { %>
          <% if (user.role === 'patient') { %>
            <li class="nav-item">
              <a class="nav-link" href="/dashboard"><i class="bi bi-grid-1x2 me-1"></i>Dashboard</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/upload"><i class="bi bi-cloud-upload me-1"></i>Upload</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/timeline"><i class="bi bi-clock-history me-1"></i>Timeline</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/lab-results"><i class="bi bi-clipboard2-pulse me-1"></i>Lab Results</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/drug-interactions"><i class="bi bi-capsule me-1"></i>Drug Check</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/summary"><i class="bi bi-file-medical me-1"></i>Summary</a>
            </li>
          <% } else if (user.role === 'doctor') { %>
            <li class="nav-item">
              <a class="nav-link" href="/doctor/dashboard"><i class="bi bi-grid-1x2 me-1"></i>Dashboard</a>
            </li>
          <% } %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
              <i class="bi bi-person-circle me-1"></i><%= user.name %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" style="background: var(--bg-card); border-color: var(--border-color);">
              <li><span class="dropdown-item-text" style="color: var(--text-muted); font-size: 0.8rem;"><%= user.email %></span></li>
              <li><hr class="dropdown-divider" style="border-color: var(--border-color);"></li>
              <li><a class="dropdown-item" href="/logout" style="color: var(--danger-500);"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
            </ul>
          </li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
          <li class="nav-item"><a class="nav-link btn-primary-custom text-white px-3 ms-2" href="/register">Get Started</a></li>
        <% } %>
        <li class="nav-item ms-2">
          <button class="theme-toggle" id="themeToggle" title="Toggle dark mode">
            <i class="bi bi-moon-stars"></i>
          </button>
        </li>
      </ul>
    </div>
  </div>
</nav>
<div style="padding-top: 70px;"></div>

<% if (typeof success !== 'undefined' && success) { %>
<div class="container mt-3">
  <div class="alert-custom alert-success fade-in" role="alert">
    <i class="bi bi-check-circle-fill" style="color: var(--success-500); font-size: 1.2rem;"></i>
    <div><%= success %></div>
  </div>
</div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
<div class="container mt-3">
  <div class="alert-custom alert-critical fade-in" role="alert">
    <i class="bi bi-exclamation-triangle-fill" style="color: var(--danger-500); font-size: 1.2rem;"></i>
    <div><%= error %></div>
  </div>
</div>
<% } %>
