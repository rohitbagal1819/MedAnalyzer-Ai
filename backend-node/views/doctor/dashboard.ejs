<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="page-container">
  <div class="page-header">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
      <div>
        <h1 class="page-title"><i class="bi bi-grid-1x2 me-2" style="color:var(--primary-500);"></i>Doctor Dashboard</h1>
        <p class="page-subtitle">Welcome, Dr. <%= doctor.name %> — Manage your patients</p>
      </div>
      <button class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#linkPatientModal">
        <i class="bi bi-person-plus me-2"></i>Link Patient
      </button>
    </div>
  </div>

  <!-- Stats -->
  <div class="dashboard-grid mb-4">
    <div class="card-custom stat-card">
      <div class="card-icon card-icon-blue" style="margin-bottom:0;"><i class="bi bi-people"></i></div>
      <div class="stat-info">
        <h3><%= patients.length %></h3>
        <p>Linked Patients</p>
      </div>
    </div>
    <div class="card-custom stat-card">
      <div class="card-icon card-icon-green" style="margin-bottom:0;"><i class="bi bi-check-circle"></i></div>
      <div class="stat-info">
        <h3><%= patients.filter(p => p.healthScore >= 70).length %></h3>
        <p>Healthy Patients</p>
      </div>
    </div>
    <div class="card-custom stat-card">
      <div class="card-icon card-icon-red" style="margin-bottom:0;"><i class="bi bi-exclamation-triangle"></i></div>
      <div class="stat-info">
        <h3><%= patients.filter(p => p.healthScore < 40).length %></h3>
        <p>Need Attention</p>
      </div>
    </div>
  </div>

  <!-- Patient Cards -->
  <% if (patients.length > 0) { %>
    <div class="row g-3">
      <% patients.forEach(patient => { %>
        <div class="col-md-6 col-lg-4">
          <div class="card-custom patient-card">
            <div class="d-flex align-items-center gap-3 mb-3">
              <div class="patient-avatar">
                <%= patient.name ? patient.name.charAt(0).toUpperCase() : '?' %>
              </div>
              <div style="flex:1;">
                <h4 style="font-weight:700; font-size:1rem; margin:0;"><%= patient.name %></h4>
                <span style="font-size:0.8rem; color:var(--text-muted);"><%= patient.email %></span>
              </div>
              <div class="mini-score <%= patient.healthScore >= 70 ? 'score-good' : patient.healthScore >= 40 ? 'score-moderate' : 'score-poor' %>">
                <%= patient.healthScore %>
              </div>
            </div>
            <div class="d-flex gap-3 mb-3" style="font-size:0.8rem; color:var(--text-muted);">
              <span><i class="bi bi-person me-1"></i><%= patient.age || '—' %> yrs</span>
              <span><i class="bi bi-gender-ambiguous me-1"></i><%= patient.gender || '—' %></span>
              <span><i class="bi bi-droplet me-1"></i><%= patient.bloodGroup || '—' %></span>
            </div>
            <div class="d-flex gap-3 mb-3" style="font-size:0.8rem;">
              <span style="color:var(--text-muted);"><i class="bi bi-file-earmark-medical me-1"></i><%= patient.reportCount %> reports</span>
            </div>
            <div class="d-flex gap-2">
              <a href="/doctor/patient/<%= patient._id %>" class="btn btn-primary-custom btn-sm flex-fill">
                <i class="bi bi-eye me-1"></i>View Details
              </a>
              <a href="/doctor/notes/<%= patient._id %>" class="btn btn-glass btn-sm flex-fill">
                <i class="bi bi-journal-text me-1"></i>Notes
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="card-custom">
      <div class="empty-state">
        <div class="empty-state-icon">👨‍⚕️</div>
        <h3>No Linked Patients</h3>
        <p>Link patients using their Health ID to view their medical data</p>
        <button class="btn btn-primary-custom mt-3" data-bs-toggle="modal" data-bs-target="#linkPatientModal">
          <i class="bi bi-person-plus me-2"></i>Link Patient
        </button>
      </div>
    </div>
  <% } %>
</div>

<!-- Link Patient Modal -->
<div class="modal fade" id="linkPatientModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius-lg);">
      <div class="modal-header" style="border-bottom-color:var(--border-color);">
        <h5 class="modal-title" style="font-weight:700;">Link Patient</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/doctor/link" method="POST">
        <div class="modal-body">
          <div class="form-floating-custom">
            <label for="healthId">Patient Health ID (ABDM)</label>
            <input type="text" class="form-control" id="healthId" name="healthId" 
                   placeholder="Enter patient's health ID" required>
          </div>
          <p style="font-size:0.8rem; color:var(--text-muted);">
            <i class="bi bi-info-circle me-1"></i>Ask your patient for their Health ID from their MedAnalyzer profile.
          </p>
        </div>
        <div class="modal-footer" style="border-top-color:var(--border-color);">
          <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary-custom">
            <i class="bi bi-link-45deg me-2"></i>Link Patient
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
