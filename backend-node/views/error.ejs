<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="page-container" style="min-height: 60vh; display:flex; align-items:center; justify-content:center;">
  <div class="text-center">
    <div style="font-size:5rem; margin-bottom:1rem; opacity:0.3;">
      <i class="bi bi-exclamation-triangle"></i>
    </div>
    <h1 style="font-weight:800; font-size:2rem; margin-bottom:0.5rem;">
      <%= typeof title !== 'undefined' ? title : 'Error' %>
    </h1>
    <p style="color:var(--text-muted); font-size:1rem; max-width:400px; margin:0 auto 1.5rem;">
      <%= typeof message !== 'undefined' ? message : 'Something went wrong.' %>
    </p>
    <a href="/" class="btn btn-primary-custom">
      <i class="bi bi-house me-2"></i>Go Home
    </a>
  </div>
</div>

<%- include('partials/footer') %>
