<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- Hero Section -->
<section class="hero-section">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6" style="position: relative; z-index: 1;">
        <h1 class="hero-title">
          Your Health Data,<br>
          <span class="highlight">Intelligently Analyzed</span>
        </h1>
        <p class="hero-subtitle">
          Upload medical reports and let AI extract lab values, detect drug interactions, 
          flag anomalies, and build your complete health timeline — all in seconds.
        </p>
        <div class="hero-cta">
          <a href="/register" class="btn btn-primary-custom btn-lg">
            <i class="bi bi-rocket-takeoff me-2"></i>Get Started Free
          </a>
          <a href="/login" class="btn btn-outline-custom btn-lg">
            <i class="bi bi-play-circle me-2"></i>Sign In
          </a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat">
            <h3>99.2%</h3>
            <p>OCR Accuracy</p>
          </div>
          <div class="hero-stat">
            <h3>50+</h3>
            <p>Lab Parameters</p>
          </div>
          <div class="hero-stat">
            <h3>&lt;30s</h3>
            <p>Analysis Time</p>
          </div>
        </div>
      </div>
      <div class="col-lg-6 d-none d-lg-block hero-visual">
        <div class="hero-card-preview">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div style="width:44px;height:44px;border-radius:50%;background:var(--gradient-success);display:flex;align-items:center;justify-content:center;">
              <i class="bi bi-heart-pulse" style="color:white;font-size:1.2rem;"></i>
            </div>
            <div>
              <div style="font-weight:700;color:#fff;">Health Score</div>
              <div style="font-size:0.8rem;color:rgba(255,255,255,0.5);">Updated today</div>
            </div>
            <div class="ms-auto" style="font-size:2.5rem;font-weight:900;color:#34d399;">87</div>
          </div>
          <div style="height:6px;background:rgba(255,255,255,0.1);border-radius:20px;overflow:hidden;margin-bottom:1.5rem;">
            <div style="height:100%;width:87%;background:linear-gradient(90deg,#34d399,#10b981);border-radius:20px;"></div>
          </div>
          <div class="row g-2">
            <div class="col-6">
              <div style="background:rgba(52,211,153,0.1);border-radius:8px;padding:0.75rem;text-align:center;">
                <div style="font-size:0.7rem;color:rgba(255,255,255,0.5);text-transform:uppercase;">Normal</div>
                <div style="font-weight:800;color:#34d399;font-size:1.2rem;">12</div>
              </div>
            </div>
            <div class="col-6">
              <div style="background:rgba(245,158,11,0.1);border-radius:8px;padding:0.75rem;text-align:center;">
                <div style="font-size:0.7rem;color:rgba(255,255,255,0.5);text-transform:uppercase;">Flagged</div>
                <div style="font-weight:800;color:#fbbf24;font-size:1.2rem;">3</div>
              </div>
            </div>
            <div class="col-6">
              <div style="background:rgba(239,68,68,0.1);border-radius:8px;padding:0.75rem;text-align:center;">
                <div style="font-size:0.7rem;color:rgba(255,255,255,0.5);text-transform:uppercase;">Critical</div>
                <div style="font-weight:800;color:#f87171;font-size:1.2rem;">1</div>
              </div>
            </div>
            <div class="col-6">
              <div style="background:rgba(139,92,246,0.1);border-radius:8px;padding:0.75rem;text-align:center;">
                <div style="font-size:0.7rem;color:rgba(255,255,255,0.5);text-transform:uppercase;">Meds</div>
                <div style="font-weight:800;color:#a78bfa;font-size:1.2rem;">5</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Features Section -->
<section class="features-section">
  <div class="container">
    <h2 class="section-title">Powerful AI Analysis Pipeline</h2>
    <p class="section-subtitle">
      From raw medical reports to actionable insights in seconds, powered by OCR, NLP, and intelligent scoring algorithms.
    </p>
    <div class="row g-4">
      <div class="col-md-6 col-lg-3">
        <div class="card-custom feature-card">
          <div class="feature-icon card-icon-blue">
            <i class="bi bi-file-earmark-text"></i>
          </div>
          <h3>OCR Extraction</h3>
          <p>Upload PDFs or images — Tesseract OCR with OpenCV preprocessing extracts every detail</p>
        </div>
      </div>
      <div class="col-md-6 col-lg-3">
        <div class="card-custom feature-card">
          <div class="feature-icon card-icon-purple">
            <i class="bi bi-cpu"></i>
          </div>
          <h3>NLP Analysis</h3>
          <p>spaCy NER identifies lab values, medications, diseases, and clinical entities</p>
        </div>
      </div>
      <div class="col-md-6 col-lg-3">
        <div class="card-custom feature-card">
          <div class="feature-icon card-icon-red">
            <i class="bi bi-exclamation-diamond"></i>
          </div>
          <h3>Drug Interactions</h3>
          <p>Cross-references medications against OpenFDA for known drug-drug interactions</p>
        </div>
      </div>
      <div class="col-md-6 col-lg-3">
        <div class="card-custom feature-card">
          <div class="feature-icon card-icon-green">
            <i class="bi bi-heart-pulse"></i>
          </div>
          <h3>Health Scoring</h3>
          <p>Composite 0-100 health score based on lab normals, anomalies, and completeness</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- How it works -->
<section style="padding: 4rem 0; background: var(--bg-secondary);">
  <div class="container">
    <h2 class="section-title">How It Works</h2>
    <p class="section-subtitle">Three simple steps to unlock AI-powered health insights</p>
    <div class="row g-4 mt-2">
      <div class="col-md-4">
        <div class="card-custom text-center" style="padding: 2.5rem;">
          <div style="width:60px;height:60px;border-radius:50%;background:var(--gradient-primary);display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;color:white;font-size:1.5rem;font-weight:800;">1</div>
          <h3 style="font-weight:700;margin-bottom:0.5rem;font-size:1.1rem;">Upload Report</h3>
          <p style="color:var(--text-muted);font-size:0.9rem;">Drag & drop any medical report — PDF, JPEG, or PNG</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card-custom text-center" style="padding: 2.5rem;">
          <div style="width:60px;height:60px;border-radius:50%;background:var(--gradient-accent);display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;color:white;font-size:1.5rem;font-weight:800;">2</div>
          <h3 style="font-weight:700;margin-bottom:0.5rem;font-size:1.1rem;">AI Analyzes</h3>
          <p style="color:var(--text-muted);font-size:0.9rem;">OCR + NLP pipeline extracts data, checks drugs, flags anomalies</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card-custom text-center" style="padding: 2.5rem;">
          <div style="width:60px;height:60px;border-radius:50%;background:var(--gradient-success);display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;color:white;font-size:1.5rem;font-weight:800;">3</div>
          <h3 style="font-weight:700;margin-bottom:0.5rem;font-size:1.1rem;">View Insights</h3>
          <p style="color:var(--text-muted);font-size:0.9rem;">Dashboard, timeline, lab trends, and printable doctor summary</p>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
